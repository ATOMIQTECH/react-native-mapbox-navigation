#!/usr/bin/env bash
# Last local gate before code leaves the machine. A commit can be made with
# --no-verify; this catches it on the way out. Both are bypassable, which is
# why .github/workflows/security-scan.yml + branch protection is the real gate.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
SCAN="$ROOT/scripts/security-scan.sh"
[ -x "$SCAN" ] || { echo "pre-push: $SCAN missing or not executable"; exit 1; }

ZERO='0000000000000000000000000000000000000000'
STATUS=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue            # branch deletion

  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/production)
      # Anything landing on a protected branch gets the full-tree scan, not
      # just the diff: a payload merged in earlier must not ride along unseen.
      echo "pre-push: $remote_ref is protected — running full-tree scan"
      "$SCAN" tree || STATUS=1
      ;;
  esac

  # The remote tip may not exist locally at all (remote ahead of us, or a fresh
  # clone). Using it as a range base fails outright, so fall back to a base we
  # actually have.
  if [ "$remote_sha" != "$ZERO" ] \
     && ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    echo "pre-push: remote tip $remote_sha is not in this clone (run: git fetch);" \
         "scanning against the upstream base instead"
    remote_sha="$ZERO"
  fi

  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null \
        || git merge-base "$local_sha" origin/main 2>/dev/null || true)
    if [ -z "$base" ]; then
      echo "pre-push: no common base found; the full-tree scan above is the check"
      continue
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  echo "pre-push: scanning $range"
  "$SCAN" range "$range" || STATUS=1
done

if [ "$STATUS" -ne 0 ]; then
  echo ""
  echo "PUSH BLOCKED. Nothing left this machine."
  exit 1
fi
exit 0
