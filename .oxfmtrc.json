{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      ["side_effect"],
      { "newlinesBetween": true },
      ["builtin", "external", "subpath"],
      { "newlinesBetween": true },
      "internal",
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "example/pnpm-lock.yaml",
    "android/build/**",
    "example/android/**",
    "example/ios/**",
    "example/.expo/**",
    "website/**",
    "**/*.md"
  ]
}
